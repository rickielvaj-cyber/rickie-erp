NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Only needed locally, for scripts/seed-kb.ts — never set these in Vercel or
# anywhere the app itself runs. service_role bypasses Row Level Security.
SUPABASE_SERVICE_ROLE_KEY=
SEED_USER_ID=

# Fase 4 (search): kunci Google Gemini API untuk embedding (aistudio.google.com/apikey; ada kuota gratis).
# Set di Vercel (Production) DAN di .env.local kalau menjalankan `npm run reindex`.
GEMINI_API_KEY=
# Opsional: model Gemini untuk AI notes (bawaan gemini-2.5-flash-lite). Isi bila Google mengganti/menghentikan modelnya.
GEMINI_TEXT_MODEL=
# Google Calendar (To-Do -> Calendar). Semua WAJIB di Vercel (Production); lihat README bagian 4c.
# GOOGLE_TOKEN_SECRET = 32 byte acak base64: `openssl rand -base64 32`. Mengenkripsi refresh token di database.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_TOKEN_SECRET=
# Opsional: hanya bila redirect URI yang didaftarkan di Google berbeda dari https://<domain>/api/google/callback
GOOGLE_REDIRECT_URI=
# SUPABASE_SERVICE_ROLE_KEY (di atas) juga dipakai script reindex. Untuk auto-reindex harian di Vercel,
# isi SUPABASE_SERVICE_ROLE_KEY dan CRON_SECRET sebagai env var Production (lihat README).
